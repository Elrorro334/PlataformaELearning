@model IEnumerable<PlataformaELearning.Models.Curso>

@{
    ViewData["Title"] = "Gestión de Cursos";
}

<div class="p-4 md:p-8 animate__animated animate__fadeIn max-w-7xl mx-auto">
    <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-gray-200 pb-6">
        <div>
            <div class="inline-block px-3 py-1 bg-university-100 text-university-700 rounded-full text-xs font-bold mb-3 tracking-widest uppercase">
                Panel de Administración
            </div>
            <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">Oferta Académica</h1>
            <p class="text-gray-500 mt-2 text-sm md:text-base">Catálogo de cursos activos, asignaciones docentes y material de estudio.</p>
        </div>
        <a asp-action="Create" class="bg-university-600 text-white px-6 py-3.5 rounded-2xl font-bold hover:bg-university-700 hover:shadow-lg hover:shadow-university-200/50 transition-all transform hover:-translate-y-1 flex items-center gap-2 w-fit">
            <i class="fas fa-layer-group"></i> Aperturar Nuevo Curso
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-gradient-to-b from-white to-gray-50 rounded-[2.5rem] shadow-sm border border-gray-100 p-16 text-center">
            <div class="w-32 h-32 bg-university-50 rounded-full flex items-center justify-center mx-auto mb-8 relative">
                <div class="absolute inset-0 bg-university-100 rounded-full animate-ping opacity-20"></div>
                <i class="fas fa-rocket text-5xl text-university-600 relative z-10"></i>
            </div>
            <h3 class="text-2xl font-extrabold text-gray-900 mb-3">Tu academia está lista para despegar</h3>
            <p class="text-gray-500 mb-10 max-w-lg mx-auto text-lg">Crea tu primer curso, asócialo a un experto y comienza a transformar el aprendizaje de tus alumnos.</p>
            <a asp-action="Create" class="bg-gray-900 text-white px-10 py-4 rounded-2xl font-bold hover:bg-gray-800 transition shadow-xl inline-flex items-center gap-3 text-lg">
                <i class="fas fa-plus"></i> Crear mi primer curso
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var item in Model)
            {
                <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-2xl hover:shadow-gray-200/50 hover:border-university-200 transition-all duration-300 group flex flex-col">

                    <div class="h-36 bg-gradient-to-br from-gray-800 to-gray-900 relative p-6 flex flex-col justify-end overflow-hidden group-hover:from-university-600 group-hover:to-university-800 transition-colors duration-500">
                        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-white via-transparent to-transparent"></div>

                        <div class="absolute top-4 right-4 bg-white/20 backdrop-blur-md rounded-xl px-3 py-1.5 text-white text-xs font-bold flex items-center gap-2 border border-white/10 shadow-sm">
                            <i class="fas fa-folder-open"></i> @(item.Contenidos?.Count() ?? 0)
                        </div>

                        <h3 class="text-white font-extrabold text-xl truncate w-full relative z-10 drop-shadow-md">@item.Nombre</h3>
                    </div>

                    <div class="p-6 flex-grow flex flex-col">
                        <p class="text-gray-500 text-sm mb-6 flex-grow line-clamp-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrEmpty(item.Descripcion) ? "Este curso aún no tiene una descripción detallada asignada en el temario oficial." : item.Descripcion)
                        </p>

                        <div class="flex items-center gap-3 mt-auto pt-4 border-t border-gray-50">
                            <div class="w-10 h-10 rounded-full bg-university-50 text-university-600 flex items-center justify-center border border-university-100 font-bold flex-shrink-0">
                                @(item.Maestro?.FirstName?.Substring(0, 1) ?? "U")@(item.Maestro?.LastName?.Substring(0, 1) ?? "")
                            </div>
                            <div class="truncate">
                                <p class="text-xs text-gray-400 font-medium uppercase tracking-wider mb-0.5">Titular</p>
                                <p class="text-sm font-bold text-gray-900 truncate">@(item.Maestro?.FirstName) @(item.Maestro?.LastName)</p>
                            </div>
                        </div>
                    </div>

                    <div class="px-5 py-4 bg-gray-50/80 border-t border-gray-100 flex justify-between items-center group-hover:bg-university-50/30 transition-colors">
                        <a asp-action="Details" asp-route-id="@item.Id" class="text-sm font-bold text-university-600 hover:text-university-800 flex items-center gap-2 transition-colors">
                            Gestionar Aula <i class="fas fa-arrow-right text-xs transform group-hover:translate-x-1 transition-transform"></i>
                        </a>

                        <div class="flex gap-1.5">
                            <a asp-action="AgregarContenido" asp-route-cursoId="@item.Id" class="w-9 h-9 rounded-xl bg-white text-green-600 flex items-center justify-center hover:bg-green-600 hover:text-white transition-all shadow-sm border border-gray-200 hover:border-green-600" title="Subir Material">
                                <i class="fas fa-cloud-upload-alt text-sm"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="w-9 h-9 rounded-xl bg-white text-amber-500 flex items-center justify-center hover:bg-amber-500 hover:text-white transition-all shadow-sm border border-gray-200 hover:border-amber-500" title="Editar">
                                <i class="fas fa-pen text-sm"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="w-9 h-9 rounded-xl bg-white text-red-500 flex items-center justify-center hover:bg-red-500 hover:text-white transition-all shadow-sm border border-gray-200 hover:border-red-500" title="Eliminar">
                                <i class="fas fa-trash text-sm"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>