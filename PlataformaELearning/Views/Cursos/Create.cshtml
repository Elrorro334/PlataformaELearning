@model PlataformaELearning.Models.Curso

@{
    ViewData["Title"] = "Crear Nuevo Curso";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Crear Nuevo Curso</h1>
        <p class="text-gray-600 mt-2">Completa los datos para crear un nuevo curso</p>
    </div>

    <!-- Formulario -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <form asp-action="Create" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm bg-red-50 p-4 rounded-lg" role="alert"></div>

            <!-- Nombre del Curso -->
            <div>
                <label asp-for="Nombre" class="block text-sm font-medium text-gray-700 mb-2"></label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fas fa-book text-gray-400"></i>
                    </div>
                    <input asp-for="Nombre" class="pl-10 block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" placeholder="Ej: Introducción a la Programación" />
                </div>
                <span asp-validation-for="Nombre" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Descripción -->
            <div>
                <label asp-for="Descripcion" class="block text-sm font-medium text-gray-700 mb-2"></label>
                <div class="relative">
                    <div class="absolute top-3 left-3 pointer-events-none">
                        <i class="fas fa-align-left text-gray-400"></i>
                    </div>
                    <textarea asp-for="Descripcion" rows="4" class="pl-10 block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" placeholder="Describe el contenido del curso..."></textarea>
                </div>
                <span asp-validation-for="Descripcion" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Profesor Asignado -->
            <div>
                <label asp-for="MaestroId" class="block text-sm font-medium text-gray-700 mb-2"></label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fas fa-chalkboard-teacher text-gray-400"></i>
                    </div>
                    <select asp-for="MaestroId" class="pl-10 block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" asp-items="ViewBag.MaestroId">
                        <option value="">Seleccione un profesor</option>
                    </select>
                </div>
                <span asp-validation-for="MaestroId" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Botones -->
            <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
                <button type="submit" class="bg-university-600 hover:bg-university-700 text-white font-medium py-2.5 px-6 rounded-lg transition transform hover:scale-105 shadow-lg shadow-university-200 flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    Guardar Curso
                </button>
                <a asp-action="Index" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2.5 px-6 rounded-lg transition flex items-center gap-2">
                    <i class="fas fa-times"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}