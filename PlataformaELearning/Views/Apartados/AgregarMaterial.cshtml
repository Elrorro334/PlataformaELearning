@model PlataformaELearning.Models.MaterialTarea

@{
    ViewData["Title"] = "Agregar Material";
    var tarea = ViewBag.Tarea as PlataformaELearning.Models.TareaApartado;
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Agregar Material</h1>
        <p class="text-gray-600 mt-2">Tarea: <span class="font-medium text-university-600">@tarea?.Titulo</span></p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <form asp-action="AgregarMaterial" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm bg-red-50 p-4 rounded-lg mb-6" role="alert"></div>

            <input type="hidden" asp-for="TareaId" />

            <div class="space-y-6">
                <!-- Título -->
                <div>
                    <label asp-for="Titulo" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="Titulo" class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" placeholder="Ej: Guía de ejercicios, Video explicativo..." />
                    <span asp-validation-for="Titulo" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Tipo de Material -->
                <div>
                    <label asp-for="Tipo" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <select asp-for="Tipo" class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" id="tipoMaterial" asp-items="ViewBag.Tipos">
                        <option value="">Seleccione tipo de material</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Contenedor para Texto -->
                <div id="contenidoTextoDiv" class="hidden">
                    <label asp-for="ContenidoTexto" class="block text-sm font-medium text-gray-700 mb-2">Contenido</label>
                    <textarea asp-for="ContenidoTexto" rows="6" class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" placeholder="Escribe el contenido aquí..."></textarea>
                </div>

                <!-- Contenedor para PDF -->
                <div id="archivoPDFDiv" class="hidden">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Archivo PDF</label>
                    <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-lg">
                        <div class="space-y-1 text-center">
                            <i class="fas fa-cloud-upload-alt text-3xl text-gray-400"></i>
                            <div class="flex text-sm text-gray-600">
                                <label for="archivoPDF" class="relative cursor-pointer bg-white rounded-md font-medium text-university-600 hover:text-university-500">
                                    <span>Sube un archivo</span>
                                    <input id="archivoPDF" name="archivoPDF" type="file" class="sr-only" accept=".pdf">
                                </label>
                                <p class="pl-1">o arrastra y suelta</p>
                            </div>
                            <p class="text-xs text-gray-500">PDF hasta 100MB</p>
                        </div>
                    </div>
                </div>

                <!-- Contenedor para Video -->
                <div id="urlVideoDiv" class="hidden">
                    <label asp-for="UrlVideo" class="block text-sm font-medium text-gray-700 mb-2">URL del Video</label>
                    <input asp-for="UrlVideo" class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" placeholder="https://www.youtube.com/embed/VIDEO_ID" />
                    <span asp-validation-for="UrlVideo" class="text-red-600 text-sm mt-1"></span>
                    <p class="text-xs text-gray-500 mt-1">Usa el formato embed de YouTube: https://www.youtube.com/embed/VIDEO_ID</p>
                </div>

                <!-- Botones -->
                <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
                    <button type="submit" class="bg-university-600 hover:bg-university-700 text-white font-medium py-2.5 px-6 rounded-lg transition transform hover:scale-105 shadow-lg shadow-university-200 flex items-center gap-2">
                        <i class="fas fa-save"></i>
                        Guardar Material
                    </button>
                    <a asp-action="DetallesTarea" asp-route-id="@Model.TareaId" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2.5 px-6 rounded-lg transition flex items-center gap-2">
                        <i class="fas fa-times"></i>
                        Cancelar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            $('#tipoMaterial').change(function() {
                var tipo = $(this).val();

                // Ocultar todos
                $('#contenidoTextoDiv').addClass('hidden');
                $('#archivoPDFDiv').addClass('hidden');
                $('#urlVideoDiv').addClass('hidden');

                // Mostrar según selección
                if (tipo == '0') { // Texto
                    $('#contenidoTextoDiv').removeClass('hidden');
                } else if (tipo == '1') { // PDF
                    $('#archivoPDFDiv').removeClass('hidden');
                } else if (tipo == '2') { // Video
                    $('#urlVideoDiv').removeClass('hidden');
                }
            });

            $('#archivoPDF').change(function() {
                var fileName = $(this).val().split('\\').pop();
                if (fileName) {
                    $(this).closest('.border-dashed').find('p').first().text('Archivo seleccionado: ' + fileName);
                }
            });
        });
    </script>
}