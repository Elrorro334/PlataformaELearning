@model PlataformaELearning.Models.TareaApartado

@{
    ViewData["Title"] = "Editar Tarea";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Editar Tarea</h1>
        <p class="text-gray-600 mt-2">Modifica los datos de la tarea "@Model.Titulo"</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <form asp-action="EditTarea" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm bg-red-50 p-4 rounded-lg mb-6" role="alert"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ApartadoId" />

            <div class="space-y-6">
                <!-- Título -->
                <div>
                    <label asp-for="Titulo" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="Titulo" class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" />
                    <span asp-validation-for="Titulo" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Descripción -->
                <div>
                    <label asp-for="Descripcion" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <textarea asp-for="Descripcion" rows="4" class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500"></textarea>
                    <span asp-validation-for="Descripcion" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Tipo de Tarea -->
                <div>
                    <label asp-for="TipoTarea" class="block text-sm font-medium text-gray-700 mb-2">Tipo de Tarea</label>
                    <input asp-for="TipoTarea" class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" />
                </div>

                <!-- Fecha Límite -->
                <div>
                    <label asp-for="FechaLimite" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="FechaLimite" type="datetime-local" class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500"
                           value="@Model.FechaLimite.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="FechaLimite" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Puntos Totales -->
                <div>
                    <label asp-for="PuntosTotales" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <input asp-for="PuntosTotales" type="number" class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" min="0" max="1000" />
                    <span asp-validation-for="PuntosTotales" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Botones -->
                <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
                    <button type="submit" class="bg-university-600 hover:bg-university-700 text-white font-medium py-2.5 px-6 rounded-lg transition transform hover:scale-105 shadow-lg shadow-university-200 flex items-center gap-2">
                        <i class="fas fa-save"></i>
                        Guardar Cambios
                    </button>
                    <a asp-action="DetallesTarea" asp-route-id="@Model.Id" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2.5 px-6 rounded-lg transition flex items-center gap-2">
                        <i class="fas fa-times"></i>
                        Cancelar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}