@model PlataformaELearning.Models.ApartadoCurso

@{
    ViewData["Title"] = "Tareas del Apartado";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">@Model.Titulo</h1>
            <p class="text-gray-600 mt-2">@(Model.Descripcion ?? "Gestiona las tareas de este apartado")</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Index" asp-route-cursoId="@Model.CursoId"
               class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg flex items-center gap-2">
                <i class="fas fa-arrow-left"></i>
                Volver a Apartados
            </a>
            <a asp-action="CreateTarea" asp-route-apartadoId="@Model.Id"
               class="bg-university-600 hover:bg-university-700 text-white px-4 py-2 rounded-lg flex items-center gap-2">
                <i class="fas fa-plus-circle"></i>
                Nueva Tarea
            </a>
        </div>
    </div>

    <!-- Lista de Tareas -->
    @if (Model.Tareas != null && Model.Tareas.Any())
    {
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var tarea in Model.Tareas.OrderBy(t => t.FechaLimite))
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
                    <div class="p-6">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex items-center gap-2">
                                <i class="fas @(tarea.FechaLimite < DateTime.Now ? "fa-clock text-red-500" : "fa-check-circle text-green-500") text-xl"></i>
                                <span class="text-xs font-medium px-2 py-1 rounded-full @(tarea.FechaLimite < DateTime.Now ? "bg-red-100 text-red-700" : "bg-green-100 text-green-700")">
                                    @(tarea.FechaLimite < DateTime.Now ? "Vencida" : "Activa")
                                </span>
                            </div>
                            <span class="text-sm font-bold text-university-600">@tarea.PuntosTotales pts</span>
                        </div>

                        <h3 class="text-lg font-semibold text-gray-900 mb-2">@tarea.Titulo</h3>

                        @if (!string.IsNullOrEmpty(tarea.TipoTarea))
                        {
                            <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full inline-block mb-3">
                                @tarea.TipoTarea
                            </span>
                        }

                        <p class="text-sm text-gray-600 mb-4 line-clamp-2">@(tarea.Descripcion ?? "Sin descripción")</p>

                        <div class="space-y-2 mb-4">
                            <div class="flex items-center text-sm text-gray-500">
                                <i class="far fa-calendar-alt w-5"></i>
                                Límite: @tarea.FechaLimite.ToString("dd/MM/yyyy HH:mm")
                            </div>
                            <div class="flex items-center text-sm text-gray-500">
                                <i class="fas fa-paperclip w-5"></i>
                                Materiales: @(tarea.Materiales?.Count() ?? 0)
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-3 border-t border-gray-100">
                            <a asp-action="DetallesTarea" asp-route-id="@tarea.Id"
                               class="text-university-600 hover:text-university-700 font-medium text-sm flex items-center gap-1">
                                Ver detalles
                                <i class="fas fa-arrow-right text-xs"></i>
                            </a>
                            <div class="flex items-center gap-1">
                                <a asp-action="EditTarea" asp-route-id="@tarea.Id"
                                   class="p-1 text-gray-400 hover:text-amber-600 transition" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="DeleteTarea" asp-route-id="@tarea.Id"
                                   class="p-1 text-gray-400 hover:text-red-600 transition" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center">
            <div class="text-gray-400 mb-4">
                <i class="fas fa-tasks text-6xl"></i>
            </div>
            <h3 class="text-xl font-medium text-gray-900 mb-2">No hay tareas en este apartado</h3>
            <p class="text-gray-500 mb-6">Crea tu primera tarea con fecha límite y materiales</p>
            <a asp-action="CreateTarea" asp-route-apartadoId="@Model.Id"
               class="bg-university-600 hover:bg-university-700 text-white px-6 py-3 rounded-lg inline-flex items-center gap-2">
                <i class="fas fa-plus-circle"></i>
                Crear Primera Tarea
            </a>
        </div>
    }
</div>