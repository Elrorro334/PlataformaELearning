@{
    ViewData["Title"] = "Recuperar Acceso";
}

<div class="min-h-[calc(100vh-80px)] py-12 px-4 relative flex items-center justify-center overflow-hidden">
    
    <div class="absolute top-10 left-1/4 w-72 h-72 bg-university-300 rounded-full mix-blend-multiply filter blur-2xl opacity-30 animate-blob"></div>
    <div class="absolute bottom-10 right-1/4 w-72 h-72 bg-blue-300 rounded-full mix-blend-multiply filter blur-2xl opacity-30 animate-blob animation-delay-2000"></div>

    <div class="w-full max-w-md bg-white/90 backdrop-blur-md p-8 sm:p-10 rounded-3xl shadow-2xl animate__animated animate__fadeInUp relative z-10 border border-gray-100">
        
        <div class="text-center mb-8">
            <div class="inline-flex bg-orange-100 p-4 rounded-2xl mb-4 shadow-inner text-orange-500">
                <i class="fas fa-key text-3xl"></i>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Recuperar Acceso</h2>
            <p class="text-sm text-gray-500 mt-2 font-medium">Ingresa tu correo institucional y te enviaremos un enlace seguro para restablecer tu contraseña.</p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="space-y-6">
            <div class="space-y-2 group">
                <label class="text-sm font-bold text-gray-700 ml-1 group-focus-within:text-university-600 transition-colors">Correo Institucional</label>
                <div class="relative">
                    <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-university-500 transition-colors"></i>
                    <input name="email" type="email" class="w-full pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-university-500 outline-none transition-all shadow-sm" placeholder="alumno@dominio.com" required />
                </div>
            </div>

            <button type="submit" class="w-full bg-university-600 text-white py-4 rounded-xl font-bold text-lg hover:bg-university-700 transition-all transform hover:-translate-y-1 shadow-lg hover:shadow-university-500/50 flex items-center justify-center gap-2">
                <i class="fas fa-paper-plane"></i> Enviar Enlace
            </button>
            
            <div class="text-center mt-6">
                <a asp-action="Login" class="text-gray-500 hover:text-university-600 font-semibold transition-colors text-sm flex items-center justify-center gap-2">
                    <i class="fas fa-arrow-left"></i> Volver al inicio de sesión
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Mostrar errores enviados desde el backend a través de ModelState
            @if (!ViewData.ModelState.IsValid)
            {
                var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage);
                foreach (var error in errors)
                {
                    <text>toastr.error('@error', 'Verifica el dato');</text>
                }
            }
        });
    </script>
}