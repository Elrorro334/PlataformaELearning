@model IEnumerable<PlataformaELearning.Models.Curso>

@{
    ViewData["Title"] = "Cursos Disponibles";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Cursos Disponibles</h1>
            <p class="text-gray-600 mt-2">Explora y elige los cursos que deseas tomar</p>
        </div>

        @if (Model.Any())
        {
            <div class="w-full md:w-96 relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-search text-gray-400"></i>
                </div>
                <input type="text" id="buscadorCursos" placeholder="Buscar por curso, descripción o maestro..." class="w-full pl-10 pr-4 py-2.5 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-university-500 focus:border-university-500 outline-none transition shadow-sm text-sm">
            </div>
        }
    </div>

    @if (Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="contenedorCursos">
            @foreach (var curso in Model)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition tarjeta-curso">
                    <div class="h-32 bg-gradient-to-br from-university-600 to-university-800 p-4 flex items-end">
                        <h3 class="text-white font-bold text-xl truncate nombre-curso" title="@curso.Nombre">@curso.Nombre</h3>
                    </div>

                    <div class="p-6">
                        <p class="text-gray-600 text-sm mb-4 line-clamp-2 descripcion-curso" title="@curso.Descripcion">
                            @(curso.Descripcion ?? "Curso sin descripción")
                        </p>

                        <div class="flex items-center gap-2 mb-4">
                            <div class="w-8 h-8 bg-university-100 rounded-full flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-chalkboard-teacher text-university-600 text-sm"></i>
                            </div>
                            <span class="text-sm text-gray-700 maestro-curso truncate">@(curso.Maestro?.FirstName ?? "Profesor") @(curso.Maestro?.LastName ?? "")</span>
                        </div>

                        <form asp-action="Inscribirse" method="post">
                            <input type="hidden" name="cursoId" value="@curso.Id" />
                            <button type="submit"
                                    class="w-full bg-university-600 hover:bg-university-700 text-white font-medium py-2 px-4 rounded-lg transition flex items-center justify-center gap-2">
                                <i class="fas fa-plus-circle"></i>
                                Inscribirme
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div id="mensajeSinResultados" class="hidden bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center mt-6">
            <div class="text-gray-300 mb-4">
                <i class="fas fa-search text-6xl"></i>
            </div>
            <h3 class="text-xl font-medium text-gray-900 mb-2">No se encontraron cursos</h3>
            <p class="text-gray-500">Intenta buscando con otros términos.</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center">
            <div class="text-gray-400 mb-4">
                <i class="fas fa-check-circle text-6xl"></i>
            </div>
            <h3 class="text-xl font-medium text-gray-900 mb-2">¡Ya estás inscrito en todos los cursos!</h3>
            <p class="text-gray-500 mb-6">No hay más cursos disponibles por ahora.</p>
            <a asp-action="MisCursos" class="text-university-600 hover:text-university-700 font-medium">
                Ver mis cursos
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#buscadorCursos").on("keyup", function () {
                var valorBusqueda = $(this).val().toLowerCase();
                var resultadosEncontrados = 0;

                $(".tarjeta-curso").each(function () {
                    var textoFila = $(this).find('.nombre-curso').text() + " " +
                                    $(this).find('.descripcion-curso').text() + " " +
                                    $(this).find('.maestro-curso').text();

                    if (textoFila.toLowerCase().indexOf(valorBusqueda) > -1) {
                        $(this).show();
                        resultadosEncontrados++;
                    } else {
                        $(this).hide();
                    }
                });

                if (resultadosEncontrados === 0 && valorBusqueda !== "") {
                    $("#mensajeSinResultados").removeClass("hidden");
                    $("#contenedorCursos").addClass("hidden");
                } else {
                    $("#mensajeSinResultados").addClass("hidden");
                    $("#contenedorCursos").removeClass("hidden");
                }
            });
        });
    </script>
}