@model PlataformaELearning.Models.TareaApartado

@{
    ViewData["Title"] = "Detalles de Tarea";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">@Model.Titulo</h1>
            <p class="text-gray-600 mt-2">
                <a asp-action="Tareas" asp-route-apartadoId="@Model.ApartadoId" class="text-university-600 hover:underline">
                    ← Volver a tareas del apartado
                </a>
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="EditTarea" asp-route-id="@Model.Id" class="bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg flex items-center gap-2">
                <i class="fas fa-edit"></i>
                Editar
            </a>
            <a asp-action="AgregarMaterial" asp-route-tareaId="@Model.Id" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg flex items-center gap-2">
                <i class="fas fa-plus"></i>
                Agregar Material
            </a>
        </div>
    </div>

    <!-- Info de la tarea -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <span class="text-sm text-gray-500 block mb-1">Estado</span>
                @if (Model.FechaLimite < DateTime.Now)
                {
                    <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm font-medium">Vencida</span>
                }
                else if ((Model.FechaLimite - DateTime.Now).TotalHours < 24)
                {
                    <span class="px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-sm font-medium">Próxima a vencer</span>
                }
                else
                {
                    <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">Activa</span>
                }
            </div>
            <div>
                <span class="text-sm text-gray-500 block mb-1">Fecha Límite</span>
                <span class="font-medium">@Model.FechaLimite.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div>
                <span class="text-sm text-gray-500 block mb-1">Puntos</span>
                <span class="font-medium">@Model.PuntosTotales pts</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.TipoTarea))
        {
            <div class="mt-4 pt-4 border-t border-gray-100">
                <span class="text-sm text-gray-500 block mb-1">Tipo de Tarea</span>
                <span class="px-3 py-1 bg-university-100 text-university-700 rounded-full text-sm">@Model.TipoTarea</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Descripcion))
        {
            <div class="mt-4 pt-4 border-t border-gray-100">
                <span class="text-sm text-gray-500 block mb-2">Descripción</span>
                <p class="text-gray-700 whitespace-pre-line">@Model.Descripcion</p>
            </div>
        }
    </div>

    <!-- Materiales de apoyo -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <i class="fas fa-paperclip text-university-600"></i>
            Materiales de Apoyo (@(Model.Materiales?.Count() ?? 0))
        </h2>

        @if (Model.Materiales != null && Model.Materiales.Any())
        {
            <div class="space-y-3">
                @foreach (var material in Model.Materiales)
                {
                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
                        <div class="flex items-center gap-3">
                            @if (material.Tipo == TipoMaterial.Texto)
                            {
                                <i class="fas fa-file-alt text-blue-500"></i>
                            }
                            else if (material.Tipo == TipoMaterial.PDF)
                            {
                                <i class="fas fa-file-pdf text-red-500"></i>
                            }
                            else if (material.Tipo == TipoMaterial.Video)
                            {
                                <i class="fas fa-video text-green-500"></i>
                            }

                            <div>
                                <h3 class="font-medium text-gray-900">@material.Titulo</h3>
                                <span class="text-xs text-gray-500">@material.Tipo</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            @if (material.Tipo == TipoMaterial.PDF && material.ArchivoFisico != null)
                            {
                                <a asp-action="DescargarMaterial" asp-route-id="@material.Id"
                                   class="text-university-600 hover:text-university-700 p-2 hover:bg-university-50 rounded-lg transition"
                                   target="_blank" title="Descargar PDF">
                                    <i class="fas fa-download"></i>
                                </a>
                            }
                            @if (material.Tipo == TipoMaterial.Video && !string.IsNullOrEmpty(material.UrlVideo))
                            {
                                <a href="@material.UrlVideo" target="_blank"
                                   class="text-university-600 hover:text-university-700 p-2 hover:bg-university-50 rounded-lg transition"
                                   title="Ver video">
                                    <i class="fas fa-external-link-alt"></i>
                                </a>
                            }

                            <form asp-action="EliminarMaterial" asp-route-id="@material.Id" method="post"
                                  onsubmit="return confirm('¿Eliminar este material?')" class="inline">
                                <button type="submit" class="text-red-500 hover:text-red-700 p-2 hover:bg-red-50 rounded-lg transition" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    @if (material.Tipo == TipoMaterial.Texto && !string.IsNullOrEmpty(material.ContenidoTexto))
                    {
                        <div class="ml-12 mt-2 p-3 bg-white border border-gray-200 rounded-lg text-gray-700">
                            @material.ContenidoTexto
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="text-center py-8">
                <div class="text-gray-400 mb-3">
                    <i class="fas fa-paperclip text-5xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No hay materiales de apoyo</h3>
                <p class="text-gray-500 mb-4">Agrega PDFs, videos o texto para ayudar a los alumnos</p>
                <a asp-action="AgregarMaterial" asp-route-tareaId="@Model.Id"
                   class="bg-university-600 hover:bg-university-700 text-white px-4 py-2 rounded-lg inline-flex items-center gap-2">
                    <i class="fas fa-plus"></i>
                    Agregar Primer Material
                </a>
            </div>
        }
    </div>
</div>