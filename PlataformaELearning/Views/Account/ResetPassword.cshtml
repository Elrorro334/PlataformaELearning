@{
    ViewData["Title"] = "Crear Nueva Contraseña";
    // Recuperamos el token que mandó el controlador
    string token = ViewData["Token"] as string ?? "";
}

<div class="min-h-[calc(100vh-80px)] py-12 px-4 relative flex items-center justify-center overflow-hidden">

    <div class="absolute top-0 right-0 w-96 h-96 bg-green-200 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>

    <div class="w-full max-w-md bg-white/90 backdrop-blur-md p-8 sm:p-10 rounded-3xl shadow-2xl animate__animated animate__zoomIn relative z-10 border border-gray-100">

        <div class="text-center mb-8">
            <div class="inline-flex bg-green-100 p-4 rounded-2xl mb-4 shadow-inner text-green-600">
                <i class="fas fa-unlock-alt text-3xl"></i>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Nueva Contraseña</h2>
            <p class="text-sm text-gray-500 mt-2 font-medium">Crea una contraseña segura para tu cuenta académica.</p>
        </div>

        <form id="resetForm" asp-action="ResetPassword" method="post" class="space-y-6">
            <input type="hidden" name="token" value="@token" />

            <div class="space-y-2 group">
                <label class="text-sm font-bold text-gray-700 ml-1 group-focus-within:text-green-600 transition-colors">Nueva Contraseña</label>
                <div class="relative">
                    <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-green-500 transition-colors"></i>
                    <input id="newPassword" name="newPassword" type="password" minlength="8" class="w-full pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-green-500 outline-none transition-all shadow-sm" placeholder="Mínimo 8 caracteres" required />
                </div>
            </div>

            <div class="space-y-2 group">
                <label class="text-sm font-bold text-gray-700 ml-1 group-focus-within:text-green-600 transition-colors">Confirmar Contraseña</label>
                <div class="relative">
                    <i class="fas fa-check-circle absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-green-500 transition-colors"></i>
                    <input id="confirmPassword" type="password" class="w-full pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-green-500 outline-none transition-all shadow-sm" placeholder="Repite tu contraseña" required />
                </div>
                <span id="passwordError" class="text-xs text-red-500 hidden ml-1 font-semibold">Las contraseñas no coinciden.</span>
            </div>

            <button type="submit" class="w-full bg-green-600 text-white py-4 rounded-xl font-bold text-lg hover:bg-green-700 transition-all transform hover:-translate-y-1 shadow-lg hover:shadow-green-500/50 flex items-center justify-center gap-2">
                <i class="fas fa-save"></i> Guardar y Entrar
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Validar que las contraseñas coincidan antes de enviar (Lado del cliente)
            $('#resetForm').on('submit', function (e) {
                var pass1 = $('#newPassword').val();
                var pass2 = $('#confirmPassword').val();

                if (pass1 !== pass2) {
                    e.preventDefault(); // Detiene el envío
                    $('#passwordError').removeClass('hidden');
                    $('#confirmPassword').addClass('border-red-500 focus:ring-red-500');
                    toastr.warning('Asegúrate de que ambas contraseñas sean idénticas.', 'Contraseñas no coinciden');
                } else {
                    $('#passwordError').addClass('hidden');
                    $('#confirmPassword').removeClass('border-red-500 focus:ring-red-500');
                }
            });

            // Errores desde el backend (C#)
            @if (!ViewData.ModelState.IsValid)
            {
                    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage);
                    foreach (var error in errors)
                    {
                            <text>toastr.error('@error', 'Error de Validación');</text>
                    }
            }
        });
    </script>
}