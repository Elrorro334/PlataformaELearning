@model PlataformaELearning.Models.User
@{
    ViewData["Title"] = "Registrar Usuario";
}

<div class="p-4 md:p-8 animate__animated animate__fadeIn max-w-3xl mx-auto">
    <div class="mb-6 flex items-center gap-4">
        <a asp-action="Index" class="w-10 h-10 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="text-2xl font-bold text-gray-800">Registrar Nuevo Usuario</h1>
    </div>

    <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="bg-red-50 text-red-600 p-4 rounded-xl mb-6 text-sm font-medium"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-bold text-gray-700 mb-2">Nombre(s) *</label>
                    <input asp-for="FirstName" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 focus:border-university-500 outline-none transition" placeholder="Ej. Carlos" required />
                    <span asp-validation-for="FirstName" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm font-bold text-gray-700 mb-2">Apellidos *</label>
                    <input asp-for="LastName" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 focus:border-university-500 outline-none transition" placeholder="Ej. García" required />
                    <span asp-validation-for="LastName" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label asp-for="Matricula" class="block text-sm font-bold text-gray-700 mb-2">Matrícula / Clave *</label>
                    <input asp-for="Matricula" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 focus:border-university-500 outline-none transition font-mono" placeholder="Ej. 23300000" required />
                    <span asp-validation-for="Matricula" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Role" class="block text-sm font-bold text-gray-700 mb-2">Rol en la Institución *</label>
                    <select asp-for="Role" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 focus:border-university-500 outline-none transition bg-white" required>
                        <option value="Alumno">Alumno</option>
                        <option value="Maestro">Maestro</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label asp-for="Email" class="block text-sm font-bold text-gray-700 mb-2">Correo Electrónico *</label>
                    <input asp-for="Email" type="email" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 focus:border-university-500 outline-none transition" placeholder="correo@institucion.edu" required />
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Telephone" class="block text-sm font-bold text-gray-700 mb-2">Teléfono (Opcional)</label>
                    <input asp-for="Telephone" type="tel" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 focus:border-university-500 outline-none transition" placeholder="10 dígitos" />
                </div>
            </div>

            <div class="mb-8">
                <label asp-for="Password" class="block text-sm font-bold text-gray-700 mb-2">Contraseña Temporal *</label>
                <input asp-for="Password" type="password" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 focus:border-university-500 outline-none transition" placeholder="Mínimo 8 caracteres" required />
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                <p class="text-xs text-gray-500 mt-2"><i class="fas fa-info-circle"></i> El usuario podrá cambiarla posteriormente desde su perfil.</p>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                <a asp-action="Index" class="px-6 py-3 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 transition">Cancelar</a>
                <button type="submit" class="px-6 py-3 bg-university-600 text-white font-bold rounded-xl hover:bg-university-700 transition flex items-center gap-2">
                    <i class="fas fa-save"></i> Guardar Usuario
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}