@model PlataformaELearning.Models.ApartadoCurso

@{
    ViewData["Title"] = "Crear Nuevo Apartado";
    var curso = ViewBag.Curso as PlataformaELearning.Models.Curso;
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Crear Nuevo Apartado</h1>
        <p class="text-gray-600 mt-2">Curso: <span class="font-medium text-university-600">@curso?.Nombre</span></p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm bg-red-50 p-4 rounded-lg mb-6" role="alert"></div>

            <input type="hidden" asp-for="CursoId" />

            <div class="space-y-6">
                <!-- Título -->
                <div>
                    <label asp-for="Titulo" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fas fa-heading text-gray-400"></i>
                        </div>
                        <input asp-for="Titulo" class="pl-10 block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" placeholder="Ej: Tema 1: Transformada de Laplace" />
                    </div>
                    <span asp-validation-for="Titulo" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Descripción -->
                <div>
                    <label asp-for="Descripcion" class="block text-sm font-medium text-gray-700 mb-2"></label>
                    <div class="relative">
                        <div class="absolute top-3 left-3 pointer-events-none">
                            <i class="fas fa-align-left text-gray-400"></i>
                        </div>
                        <textarea asp-for="Descripcion" rows="4" class="pl-10 block w-full border-gray-300 rounded-lg shadow-sm focus:ring-university-500 focus:border-university-500" placeholder="Describe el contenido de este apartado..."></textarea>
                    </div>
                    <span asp-validation-for="Descripcion" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Botones -->
                <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
                    <button type="submit" class="bg-university-600 hover:bg-university-700 text-white font-medium py-2.5 px-6 rounded-lg transition transform hover:scale-105 shadow-lg shadow-university-200 flex items-center gap-2">
                        <i class="fas fa-save"></i>
                        Guardar Apartado
                    </button>
                    <a asp-action="Index" asp-route-cursoId="@Model.CursoId" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2.5 px-6 rounded-lg transition flex items-center gap-2">
                        <i class="fas fa-times"></i>
                        Cancelar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}