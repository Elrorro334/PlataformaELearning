@model PlataformaELearning.Models.ViewModels.CreateMaestroViewModel

@{
    ViewData["Title"] = "Alta de Maestro y Curso";
}

<div class="p-4 md:p-8 animate__animated animate__fadeIn max-w-4xl mx-auto">
    <div class="mb-6 flex items-center gap-4">
        <a asp-action="Index" class="w-10 h-10 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center hover:bg-gray-200 transition">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Incorporación de Docente Titular</h1>
            <p class="text-gray-500 text-sm">Registra al maestro y asígnale su primer curso en un solo paso.</p>
        </div>
    </div>

    <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
        <form asp-action="CreateMaestro" method="post">
            <div asp-validation-summary="ModelOnly" class="bg-red-50 text-red-600 p-4 rounded-xl mb-6 text-sm font-medium"></div>

            <h2 class="text-lg font-bold text-university-700 mb-4 border-b border-gray-100 pb-2 flex items-center gap-2">
                <i class="fas fa-user-tie"></i> Datos del Docente
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-bold text-gray-700 mb-2">Nombre(s) *</label>
                    <input asp-for="FirstName" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 outline-none" required />
                    <span asp-validation-for="FirstName" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm font-bold text-gray-700 mb-2">Apellidos *</label>
                    <input asp-for="LastName" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 outline-none" required />
                    <span asp-validation-for="LastName" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label asp-for="Matricula" class="block text-sm font-bold text-gray-700 mb-2">Número de Empleado / Clave *</label>
                    <input asp-for="Matricula" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 outline-none font-mono" required />
                    <span asp-validation-for="Matricula" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-sm font-bold text-gray-700 mb-2">Correo Institucional *</label>
                    <input asp-for="Email" type="email" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 outline-none" required />
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div>
                    <label asp-for="Password" class="block text-sm font-bold text-gray-700 mb-2">Contraseña de Acceso *</label>
                    <input asp-for="Password" type="password" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 outline-none" required />
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Telephone" class="block text-sm font-bold text-gray-700 mb-2">Teléfono de Contacto</label>
                    <input asp-for="Telephone" type="tel" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 outline-none" />
                </div>
            </div>

            <h2 class="text-lg font-bold text-university-700 mb-4 border-b border-gray-100 pb-2 flex items-center gap-2 mt-8">
                <i class="fas fa-book"></i> Asignación de Curso Inicial
            </h2>

            <div class="mb-6">
                <label asp-for="NombreCurso" class="block text-sm font-bold text-gray-700 mb-2">Nombre del Curso *</label>
                <input asp-for="NombreCurso" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 outline-none" placeholder="Ej. Matemáticas Avanzadas" required />
                <span asp-validation-for="NombreCurso" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="mb-8">
                <label asp-for="DescripcionCurso" class="block text-sm font-bold text-gray-700 mb-2">Descripción del Curso (Opcional)</label>
                <textarea asp-for="DescripcionCurso" rows="3" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-university-500 outline-none resize-none"></textarea>
                <span asp-validation-for="DescripcionCurso" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                <a asp-action="Index" class="px-6 py-3 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 transition">Cancelar</a>
                <button type="submit" class="px-6 py-3 bg-university-600 text-white font-bold rounded-xl hover:bg-university-700 transition flex items-center gap-2">
                    <i class="fas fa-save"></i> Procesar Alta Dual
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}