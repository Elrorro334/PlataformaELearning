@model IEnumerable<PlataformaELearning.Models.User>

@{
    ViewData["Title"] = "Calificar Alumnos";
    var calificaciones = ViewBag.Calificaciones as List<PlataformaELearning.Models.Calificacion> ?? new List<PlataformaELearning.Models.Calificacion>();
}

<div class="p-4 md:p-8 animate__animated animate__fadeIn max-w-7xl mx-auto">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-gray-200 pb-6">
        <div>
            <div class="inline-block px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-bold mb-3 tracking-widest uppercase">
                Gestión Académica
            </div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">@ViewBag.CursoNombre</h1>
            <p class="text-gray-500 mt-2">Lista de alumnos inscritos y control de calificaciones finales.</p>
        </div>
        <a asp-action="MisCursos" class="text-sm font-bold text-gray-500 hover:text-gray-700 flex items-center gap-2 px-4 py-2 border border-gray-200 rounded-xl transition-colors">
            <i class="fas fa-chevron-left text-xs"></i> Volver a mis cursos
        </a>
    </div>

    <div class="bg-white rounded-[2rem] shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50/50 border-b border-gray-100 text-gray-400 text-xs font-bold uppercase tracking-widest">
                        <th class="px-8 py-5">Matrícula</th>
                        <th class="px-8 py-5">Alumno</th>
                        <th class="px-8 py-5 text-center">Estado</th>
                        <th class="px-8 py-5 text-center">Calificación</th>
                        <th class="px-8 py-5 text-right">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (var alumno in Model)
                    {
                        var nota = calificaciones.FirstOrDefault(c => c.AlumnoId == alumno.Id);
                        <tr class="hover:bg-gray-50/50 transition-colors group">
                            <td class="px-8 py-5">
                                <span class="bg-gray-100 text-gray-600 px-3 py-1 rounded-lg font-mono text-sm border border-gray-200">
                                    @alumno.Matricula
                                </span>
                            </td>
                            <td class="px-8 py-5">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold border border-blue-100">
                                        @(alumno.FirstName?.Substring(0, 1))@(alumno.LastName?.Substring(0, 1))
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-gray-900">@alumno.FirstName @alumno.LastName</p>
                                        <p class="text-xs text-gray-400">@alumno.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-5 text-center">
                                @if (nota != null)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Calificado
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-700 text-xs font-bold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Pendiente
                                    </span>
                                }
                            </td>
                            <td class="px-8 py-5 text-center">
                                @if (nota != null)
                                {
                                    <span class="text-xl font-black @(nota.Puntuacion >= 6 ? "text-blue-600" : "text-red-500")">
                                        @nota.Puntuacion.ToString("0.0")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-gray-300 font-bold">--</span>
                                }
                            </td>
                            <td class="px-8 py-5 text-right">
                                <a asp-action="AsignarCalificacion"
                                   asp-route-cursoId="@ViewBag.CursoId"
                                   asp-route-alumnoId="@alumno.Id"
                                   class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all @(nota != null ? "bg-white text-gray-600 border border-gray-200 hover:bg-gray-50" : "bg-blue-600 text-white hover:bg-blue-700 shadow-md shadow-blue-200")">
                                    <i class="fas @(nota != null ? "fa-edit" : "fa-plus-circle")"></i>
                                    @(nota != null ? "Editar" : "Calificar")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>