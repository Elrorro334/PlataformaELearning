@model PlataformaELearning.Models.TareaApartado

@{
    ViewData["Title"] = "Eliminar Tarea";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <!-- Icono de advertencia -->
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-red-100 rounded-full mb-4">
                <i class="fas fa-exclamation-triangle text-red-600 text-4xl"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 mb-2">¿Eliminar Tarea?</h1>
            <p class="text-gray-600">Esta acción eliminará la tarea y <strong>TODOS sus materiales</strong>. Esta acción no se puede deshacer.</p>
        </div>

        <!-- Detalles de la tarea -->
        <div class="bg-gray-50 rounded-lg p-4 mb-6">
            <h3 class="font-medium text-gray-900 mb-3">Tarea a eliminar:</h3>
            <dl class="space-y-2">
                <div class="flex">
                    <dt class="w-24 text-sm text-gray-500">Título:</dt>
                    <dd class="text-sm text-gray-900">@Model.Titulo</dd>
                </div>
                @if (!string.IsNullOrEmpty(Model.TipoTarea))
                {
                    <div class="flex">
                        <dt class="w-24 text-sm text-gray-500">Tipo:</dt>
                        <dd class="text-sm text-gray-900">@Model.TipoTarea</dd>
                    </div>
                }
                <div class="flex">
                    <dt class="w-24 text-sm text-gray-500">Límite:</dt>
                    <dd class="text-sm text-gray-900">@Model.FechaLimite.ToString("dd/MM/yyyy HH:mm")</dd>
                </div>
                <div class="flex">
                    <dt class="w-24 text-sm text-gray-500">Puntos:</dt>
                    <dd class="text-sm text-gray-900">@Model.PuntosTotales pts</dd>
                </div>
                <div class="flex">
                    <dt class="w-24 text-sm text-gray-500">Materiales:</dt>
                    <dd class="text-sm text-gray-900">@(Model.Materiales?.Count() ?? 0)</dd>
                </div>
            </dl>
        </div>

        <!-- Formulario de confirmación -->
        <form asp-action="DeleteTarea" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ApartadoId" />
            <div class="flex items-center justify-center gap-3">
                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-medium py-2.5 px-6 rounded-lg transition flex items-center gap-2">
                    <i class="fas fa-trash"></i>
                    Sí, Eliminar Tarea
                </button>
                <a asp-action="Tareas" asp-route-apartadoId="@Model.ApartadoId" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2.5 px-6 rounded-lg transition flex items-center gap-2">
                    <i class="fas fa-times"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>