@model IEnumerable<PlataformaELearning.Models.Curso>

@{
    ViewData["Title"] = "Mis Cursos";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Mis Cursos</h1>
            <p class="text-gray-600 mt-2">Cursos en los que estás inscrito</p>
        </div>
        <a asp-action="CursosDisponibles"
           class="bg-university-600 hover:bg-university-700 text-white px-4 py-2 rounded-lg flex items-center gap-2">
            <i class="fas fa-search"></i>
            Explorar Cursos
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var curso in Model)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
                    <div class="h-32 bg-gradient-to-br from-gray-800 to-gray-900 p-4 flex items-end">
                        <h3 class="text-white font-bold text-xl truncate">@curso.Nombre</h3>
                    </div>

                    <div class="p-6">
                        <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                            @(curso.Descripcion ?? "Curso sin descripción")
                        </p>

                        <div class="flex items-center gap-2 mb-4">
                            <div class="w-8 h-8 bg-university-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-chalkboard-teacher text-university-600 text-sm"></i>
                            </div>
                            <span class="text-sm text-gray-700">@(curso.Maestro?.FirstName ?? "Profesor") @(curso.Maestro?.LastName ?? "")</span>
                        </div>

                        <div class="flex gap-2">
                            <a asp-controller="Cursos" asp-action="Details" asp-route-id="@curso.Id"
                               class="flex-1 bg-university-600 hover:bg-university-700 text-white text-center font-medium py-2 px-3 rounded-lg text-sm transition">
                                Entrar
                            </a>
                            <form asp-action="Desinscribirse" method="post" class="flex">
                                <input type="hidden" name="cursoId" value="@curso.Id" />
                                <button type="submit"
                                        class="bg-red-50 hover:bg-red-100 text-red-600 font-medium py-2 px-3 rounded-lg text-sm transition"
                                        onclick="return confirm('¿Desinscribirte del curso?')">
                                    <i class="fas fa-times"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center">
            <div class="text-gray-400 mb-4">
                <i class="fas fa-book-open text-6xl"></i>
            </div>
            <h3 class="text-xl font-medium text-gray-900 mb-2">No estás inscrito en ningún curso</h3>
            <p class="text-gray-500 mb-6">Explora los cursos disponibles y comienza tu aprendizaje</p>
            <a asp-action="CursosDisponibles"
               class="bg-university-600 hover:bg-university-700 text-white px-6 py-3 rounded-lg inline-flex items-center gap-2">
                <i class="fas fa-search"></i>
                Ver Cursos Disponibles
            </a>
        </div>
    }
</div>