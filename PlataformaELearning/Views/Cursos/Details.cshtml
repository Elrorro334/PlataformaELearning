@model PlataformaELearning.Models.Curso

@{
    ViewData["Title"] = "Detalles del Curso";
    ViewBag.CursoNombre = Model.Nombre;
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">@Model.Nombre</h1>
            <p class="text-gray-600 mt-2">@(Model.Descripcion ?? "Sin descripción")</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg flex items-center gap-2">
                <i class="fas fa-edit"></i>
                Editar
            </a>
            <a asp-action="AgregarContenido" asp-route-cursoId="@Model.Id" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg flex items-center gap-2">
                <i class="fas fa-plus"></i>
                Agregar Contenido
            </a>
            <a asp-action="Index" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg flex items-center gap-2">
                <i class="fas fa-arrow-left"></i>
                Volver
            </a>
        </div>
    </div>

    <!-- Info del Profesor -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <i class="fas fa-chalkboard-teacher text-university-600"></i>
            Profesor del Curso
        </h2>
        <div class="flex items-center">
            <div class="h-12 w-12 bg-university-100 rounded-full flex items-center justify-center">
                <i class="fas fa-user text-university-600 text-xl"></i>
            </div>
            <div class="ml-4">
                <p class="text-sm font-medium text-gray-900">@(Model.Maestro?.Email ?? "No asignado")</p>
                <p class="text-sm text-gray-500">ID: @Model.MaestroId</p>
            </div>
        </div>
    </div>

    <!-- Contenido del Curso -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <i class="fas fa-film text-university-600"></i>
            Contenido del Curso (@(Model.Contenidos?.Count() ?? 0) items)
        </h2>

        @if (Model.Contenidos != null && Model.Contenidos.Any())
        {
            <div class="space-y-4">
                @foreach (var contenido in Model.Contenidos.OrderByDescending(c => c.FechaPublicacion))
                {
                    <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition">
                        <div class="flex items-start justify-between">
                            <div class="flex items-start gap-3">
                                <!-- Icono según tipo -->
                                <div class="mt-1">
                                    @switch (contenido.Tipo)
                                    {
                                        case TipoContenido.Anuncio:
                                            <i class="fas fa-bullhorn text-amber-500 text-xl"></i>
                                            break;
                                        case TipoContenido.PDF:
                                            <i class="fas fa-file-pdf text-red-500 text-xl"></i>
                                            break;
                                        case TipoContenido.Video:
                                            <i class="fas fa-video text-blue-500 text-xl"></i>
                                            break;
                                    }
                                </div>

                                <div>
                                    <h3 class="font-medium text-gray-900">@contenido.Titulo</h3>
                                    <p class="text-sm text-gray-500">
                                        Publicado: @contenido.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
                                    </p>

                                    @if (contenido.Tipo == TipoContenido.Anuncio && !string.IsNullOrEmpty(contenido.ContenidoTexto))
                                    {
                                        <p class="mt-2 text-gray-700">@contenido.ContenidoTexto</p>
                                    }

                                    @if (contenido.Tipo == TipoContenido.PDF && !string.IsNullOrEmpty(contenido.RutaArchivo))
                                    {
                                        <a href="@contenido.RutaArchivo" target="_blank" class="mt-2 inline-flex items-center gap-2 text-university-600 hover:text-university-700">
                                            <i class="fas fa-download"></i>
                                            @(contenido.NombreArchivo ?? "Ver PDF")
                                        </a>
                                    }

                                    @if (contenido.Tipo == TipoContenido.Video && !string.IsNullOrEmpty(contenido.UrlVideo))
                                    {
                                        <div class="mt-3 aspect-w-16 aspect-h-9">
                                            <iframe src="@contenido.UrlVideo"
                                                    class="w-full h-64 rounded-lg"
                                                    frameborder="0"
                                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                    allowfullscreen>
                                            </iframe>
                                        </div>
                                    }
                                </div>
                            </div>

                            <a asp-action="EliminarContenido" asp-route-id="@contenido.Id"
                               class="text-red-500 hover:text-red-700 p-2 hover:bg-red-50 rounded-lg transition"
                               onclick="return confirm('¿Estás seguro de eliminar este contenido?')">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <div class="text-gray-400 mb-4">
                    <i class="fas fa-film text-6xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No hay contenido en este curso</h3>
                <p class="text-gray-500 mb-4">Agrega anuncios, PDFs o videos para empezar</p>
                <a asp-action="AgregarContenido" asp-route-cursoId="@Model.Id" class="bg-university-600 text-white px-6 py-2 rounded-lg hover:bg-university-700 inline-flex items-center gap-2">
                    <i class="fas fa-plus"></i>
                    Agregar Primer Contenido
                </a>
            </div>
        }
    </div>
</div>