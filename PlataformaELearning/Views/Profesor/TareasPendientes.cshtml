@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Tareas Pendientes de Calificar";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 animate__animated animate__fadeIn">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Tareas Pendientes de Calificar</h1>
        <p class="text-gray-600 mt-2">Entregas de alumnos que esperan calificación</p>
    </div>

    @if (Model.Any())
    {
        <div class="space-y-6">
            @foreach (var item in Model)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="bg-gray-50 px-6 py-4 border-b border-gray-100">
                        <h2 class="text-xl font-semibold text-gray-900">@item.Tarea.Titulo</h2>
                        <p class="text-sm text-gray-600">@item.Tarea.Apartado.Curso.Nombre - @item.Tarea.Apartado.Titulo</p>
                    </div>

                    <div class="p-6">
                        <div class="space-y-4">
                            @foreach (var entrega in item.EntregasSinCalificar)
                            {
                                <div class="flex flex-col md:flex-row md:items-center justify-between p-4 bg-gray-50 rounded-lg hover:shadow-md transition gap-4">
                                    <div class="flex items-start gap-4">
                                        <div class="w-10 h-10 bg-university-100 rounded-full flex items-center justify-center flex-shrink-0">
                                            <i class="fas fa-user text-university-600"></i>
                                        </div>
                                        <div>
                                            <p class="font-medium text-gray-900">@entrega.Alumno.FirstName @entrega.Alumno.LastName</p>
                                            <p class="text-sm text-gray-500">Entregado: @entrega.FechaEntrega.ToString("dd/MM/yyyy HH:mm")</p>
                                            @if (!string.IsNullOrEmpty((string)entrega.ComentarioAlumno))
                                            {
                                                <p class="text-sm text-gray-600 mt-2 bg-white p-2 rounded border border-gray-100">📝 @entrega.ComentarioAlumno</p>
                                            }
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-2 md:gap-3 shrink-0">
                                        @if (entrega.ArchivoEntregado != null && !string.IsNullOrEmpty((string)entrega.NombreArchivo))
                                        {
                                            string filename = (string)entrega.NombreArchivo;
                                            string ext = System.IO.Path.GetExtension(filename).ToLower();
                                            // Se evalúa si el navegador puede pintar el archivo nativamente en un iframe
                                            bool isPreviewable = ext == ".pdf" || ext == ".jpg" || ext == ".jpeg" || ext == ".png";

                                            @if (isPreviewable)
                                            {
                                                <button type="button"
                                                        onclick="abrirModalPreview('@Url.Action("PrevisualizarEntrega", "Profesor", new { id = entrega.Id })', '@filename')"
                                                        class="text-university-600 hover:text-university-700 p-2.5 bg-white border border-gray-200 hover:bg-university-50 rounded-lg transition shadow-sm"
                                                        title="Ver documento">
                                                    <i class="fas fa-eye text-lg"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-2 py-1 rounded border border-amber-200 uppercase">
                                                    Formato @ext no previsualizable
                                                </span>
                                            }
                                        }

                                        <a asp-action="CalificarEntrega" asp-route-entregaId="@entrega.Id"
                                           class="bg-university-600 hover:bg-university-700 text-white font-bold px-4 py-2.5 rounded-lg shadow-sm transition">
                                            Calificar
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center">
            <div class="text-gray-400 mb-4">
                <i class="fas fa-check-circle text-6xl"></i>
            </div>
            <h3 class="text-xl font-medium text-gray-900 mb-2">¡No hay tareas pendientes!</h3>
            <p class="text-gray-500">Todas las entregas han sido calificadas.</p>
        </div>
    }
</div>

<div id="previewModal" class="fixed inset-0 z-[100] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-gray-900/80 backdrop-blur-sm transition-opacity" id="previewModalBackdrop"></div>

    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all w-full max-w-5xl h-[85vh] flex flex-col animate__animated animate__zoomIn">

                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex justify-between items-center shrink-0">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <div class="w-10 h-10 bg-university-100 rounded-lg flex items-center justify-center text-university-600 shrink-0">
                            <i class="fas fa-eye"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 truncate" id="previewModalTitle">Visualizador de Documentos</h3>
                    </div>
                    <button type="button" id="btnClosePreviewModal" class="rounded-lg p-2 text-gray-400 hover:bg-red-50 hover:text-red-500 focus:outline-none transition">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>

                <div class="bg-gray-100 flex-grow relative w-full h-full p-2 md:p-6">
                    <div class="w-full h-full bg-white rounded-xl shadow-inner border border-gray-200 overflow-hidden relative flex items-center justify-center">

                        <div id="previewLoader" class="absolute inset-0 flex flex-col items-center justify-center bg-white z-10">
                            <i class="fas fa-circle-notch fa-spin text-4xl text-university-600 mb-4"></i>
                            <p class="text-gray-500 font-bold animate-pulse">Cargando documento...</p>
                        </div>

                        <iframe id="previewIframe" src="" class="w-full h-full border-0 absolute inset-0 z-20 hidden" onload="document.getElementById('previewLoader').classList.add('hidden'); this.classList.remove('hidden');"></iframe>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalPreview(url, filename) {
            $('#previewModal').removeClass('hidden');
            $('body').css('overflow', 'hidden');

            $('#previewModalTitle').text(filename);

            $('#previewLoader').removeClass('hidden');
            $('#previewIframe').addClass('hidden');

            $('#previewIframe').attr('src', url + "#toolbar=0");
        }

        function cerrarModalPreview() {
            $('#previewModal').addClass('hidden');
            $('body').css('overflow', 'auto');
            $('#previewIframe').attr('src', '');
        }

        $(document).ready(function () {
            $('#btnClosePreviewModal').click(cerrarModalPreview);
            $('#previewModalBackdrop').click(cerrarModalPreview);

            $(document).keyup(function(e) {
                if (e.key === "Escape" && !$('#previewModal').hasClass('hidden')) {
                    cerrarModalPreview();
                }
            });
        });
    </script>
}