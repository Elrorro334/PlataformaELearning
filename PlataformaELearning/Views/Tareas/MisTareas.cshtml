@model IEnumerable<PlataformaELearning.Models.TareaApartado>

@{
    ViewData["Title"] = "Mis Tareas Pendientes";
    var entregas = ViewBag.Entregas as Dictionary<int, PlataformaELearning.Models.EntregaTarea>;
    bool tieneInscripciones = ViewBag.TieneInscripciones != null ? (bool)ViewBag.TieneInscripciones : true;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Mis Tareas Pendientes</h1>
        <p class="text-gray-600 mt-2">Tareas de los cursos en los que estás inscrito</p>
    </div>

    @if (!tieneInscripciones)
    {
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
            <div class="flex items-center gap-3">
                <i class="fas fa-exclamation-triangle text-amber-600"></i>
                <p class="text-amber-800">
                    No estás inscrito en ningún curso.
                    <a asp-controller="Inscripciones" asp-action="CursosDisponibles" class="font-medium underline">
                        Explora cursos disponibles
                    </a>
                </p>
            </div>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var tarea in Model)
            {
                bool entregada = entregas != null && entregas.ContainsKey(tarea.Id);
                bool vencida = tarea.FechaLimite < DateTime.Now;
                bool proxima = !vencida && (tarea.FechaLimite - DateTime.Now).TotalDays <= 2;
                string cursoNombre = tarea.Apartado?.Curso?.Nombre ?? "Curso sin nombre";

                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group">

                    <!-- Barra de estado -->
                    <div class="h-2 @(vencida ? "bg-red-500" : (proxima ? "bg-amber-500" : "bg-green-500"))"></div>

                    <div class="p-6">
                        <!-- Estado -->
                        <div class="flex items-center justify-between mb-3">
                            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium
                                @(entregada ? "bg-green-100 text-green-700" :
                                  (vencida ? "bg-red-100 text-red-700" :
                                  (proxima ? "bg-amber-100 text-amber-700" : "bg-blue-100 text-blue-700")))">

                                @if (entregada)
                                {
                                    <i class="fas fa-check-circle"></i>
                                    <span>Entregada</span>
                                }
                                else if (vencida)
                                {
                                    <i class="fas fa-clock"></i>
                                    <span>Vencida</span>
                                }
                                else if (proxima)
                                {
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <span>Próxima a vencer</span>
                                }
                                else
                                {
                                    <i class="fas fa-hourglass-half"></i>
                                    <span>Pendiente</span>
                                }
                            </span>

                            <span class="text-sm font-bold text-university-600">
                                @tarea.PuntosTotales pts
                            </span>
                        </div>

                        <!-- Título -->
                        <h3 class="text-lg font-semibold text-gray-900 mb-1">
                            @tarea.Titulo
                        </h3>

                        <p class="text-sm text-university-600 mb-3">
                            @cursoNombre
                        </p>

                        @if (!string.IsNullOrEmpty(tarea.TipoTarea))
                        {
                            <span class="inline-block text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full mb-3">
                                @tarea.TipoTarea
                            </span>
                        }

                        <!-- Fecha -->
                        <div class="flex items-center gap-2 text-sm mb-4
                            @(vencida ? "text-red-600" : (proxima ? "text-amber-600" : "text-gray-600"))">
                            <i class="far fa-calendar-alt"></i>
                            <span>
                                Límite: @tarea.FechaLimite.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>

                        <!-- Materiales -->
                        @if (tarea.Materiales != null && tarea.Materiales.Any())
                        {
                            <div class="flex items-center gap-2 text-xs text-gray-500 mb-4">
                                <i class="fas fa-paperclip"></i>
                                <span>@tarea.Materiales.Count() materiales de apoyo</span>
                            </div>
                        }

                        <!-- Acción -->
                        @if (vencida)
                        {
                            <div class="block w-full text-center py-2.5 rounded-lg font-medium bg-gray-300 text-gray-500 cursor-not-allowed">
                                <i class="fas fa-ban mr-1"></i> Tarea vencida
                            </div>
                        }
                        else
                        {
                            <a asp-action="Detalle" asp-route-id="@tarea.Id"
                               class="block w-full text-center py-2.5 rounded-lg font-medium transition
                               @(entregada ? "bg-green-600 hover:bg-green-700 text-white" : "bg-university-600 hover:bg-university-700 text-white")">

                                @if (entregada)
                                {
                                    <i class="fas fa-eye mr-1"></i> <span>Ver mi entrega</span>
                                }
                                else
                                {
                                    <i class="fas fa-upload mr-1"></i> <span>Entregar tarea</span>
                                }
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (tieneInscripciones)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center">
            <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="fas fa-check-circle text-4xl text-green-600"></i>
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-2">
                ¡No hay tareas pendientes!
            </h3>

            <p class="text-gray-500 mb-6">
                Por ahora no tienes tareas por entregar. Disfruta el descanso.
            </p>

            <a asp-controller="Inscripciones" asp-action="MisCursos"
               class="text-university-600 hover:text-university-700 font-medium">
                Ver mis cursos
            </a>
        </div>
    }
</div>