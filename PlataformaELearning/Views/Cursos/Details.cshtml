@using PlataformaELearning.Models
@model PlataformaELearning.Models.Curso

@{
    ViewData["Title"] = "Detalles del Curso";
    ViewBag.CursoNombre = Model.Nombre;
    // Recuperamos el diccionario de entregas enviado desde el controlador
    var entregas = ViewBag.Entregas as Dictionary<int, EntregaTarea>;
}

<div class="p-4 md:p-8 animate__animated animate__fadeIn max-w-5xl mx-auto">

    <a asp-action="Index" class="inline-flex items-center gap-2 text-gray-500 hover:text-university-600 font-medium mb-6 transition-colors">
        <i class="fas fa-arrow-left"></i> Volver al Catálogo
    </a>

    <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-[2rem] p-8 md:p-10 shadow-2xl mb-8 relative overflow-hidden">
        <div class="absolute top-0 right-0 -mt-10 -mr-10 w-64 h-64 bg-white opacity-5 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-40 h-40 bg-university-500 opacity-20 rounded-full blur-2xl"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="text-white max-w-2xl">
                <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-md text-white rounded-full text-xs font-bold mb-4 tracking-widest uppercase border border-white/10">
                    Aula Virtual
                </span>
                <h1 class="text-3xl md:text-5xl font-extrabold mb-4 tracking-tight">@Model.Nombre</h1>
                <p class="text-gray-300 text-sm md:text-base leading-relaxed">
                    @(Model.Descripcion ?? "Sin descripción asignada para este curso.")
                </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 min-w-max">
                @if (User.IsInRole("Administrador") || User.IsInRole("Maestro"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white border border-white/20 rounded-xl font-bold transition-all backdrop-blur-md flex items-center justify-center gap-2">
                        <i class="fas fa-pen"></i> Editar Info
                    </a>
                    <a asp-action="AgregarContenido" asp-route-cursoId="@Model.Id" class="px-6 py-3 bg-university-500 hover:bg-university-400 text-white rounded-xl font-bold transition-all shadow-lg shadow-university-500/30 flex items-center justify-center gap-2">
                        <i class="fas fa-cloud-upload-alt"></i> Subir Material
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <div class="lg:col-span-2 space-y-6">
            <div class="flex items-center justify-between mb-2">
                <h2 class="text-2xl font-bold text-gray-900">Material de Estudio</h2>
                <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm font-bold">
                    @(Model.Contenidos?.Count() ?? 0) items
                </span>
            </div>

            @if (Model.Contenidos != null && Model.Contenidos.Any())
            {
                <div class="space-y-6">
                    @foreach (var contenido in Model.Contenidos.OrderByDescending(c => c.FechaPublicacion))
                    {
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">

                            <div class="px-6 py-4 border-b border-gray-50 flex justify-between items-center bg-gray-50/50">
                                <div class="flex items-center gap-3">
                                    @switch (contenido.Tipo)
                                    {
                                        case TipoContenido.Anuncio:
                                            <div class="w-10 h-10 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center"><i class="fas fa-bullhorn"></i></div>
                                            break;
                                        case TipoContenido.PDF:
                                            <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center"><i class="fas fa-file-pdf"></i></div>
                                            break;
                                        case TipoContenido.Video:
                                            <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center"><i class="fas fa-play"></i></div>
                                            break;
                                    }
                                    <div>
                                        <h3 class="font-bold text-gray-900 text-lg">@contenido.Titulo</h3>
                                        <p class="text-xs text-gray-500 font-medium"><i class="far fa-clock mr-1"></i> Publicado: @contenido.FechaPublicacion.ToString("dd MMM yyyy, HH:mm")</p>
                                    </div>
                                </div>

                                @if (User.IsInRole("Administrador") || User.IsInRole("Maestro"))
                                {
                                    <a asp-action="EliminarContenido" asp-route-id="@contenido.Id"
                                       class="w-8 h-8 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 flex items-center justify-center transition"
                                       onclick="return confirm('¿Eliminar este material permanentemente?')" title="Eliminar material">
                                        <i class="fas fa-trash-alt text-sm"></i>
                                    </a>
                                }
                            </div>

                            <div class="p-6">
                                @if (contenido.Tipo == TipoContenido.Anuncio && !string.IsNullOrEmpty(contenido.ContenidoTexto))
                                {
                                    <div class="prose max-w-none text-gray-700">
                                        <p class="leading-relaxed whitespace-pre-line">@contenido.ContenidoTexto</p>
                                    </div>
                                }

                                @if (contenido.Tipo == TipoContenido.PDF)
                                {
                                    <div class="flex items-center justify-between p-4 rounded-xl bg-gray-50 border border-gray-200 group hover:border-university-300 transition-colors">
                                        <div class="flex items-center gap-4 overflow-hidden">
                                            <i class="fas fa-file-pdf text-3xl text-red-500"></i>
                                            <div class="truncate">
                                                <p class="font-bold text-gray-800 truncate">@(contenido.NombreArchivo ?? "Documento_Adjunto.pdf")</p>
                                                <p class="text-xs text-gray-500 uppercase tracking-wide">Documento PDF</p>
                                            </div>
                                        </div>
                                        <a href="@Url.Action("DescargarPDF", "Cursos", new { id = contenido.Id })" target="_blank"
                                           class="shrink-0 ml-4 px-5 py-2.5 bg-white text-university-600 font-bold rounded-lg border border-gray-200 shadow-sm group-hover:bg-university-600 group-hover:text-white transition-all flex items-center gap-2">
                                            <i class="fas fa-download"></i> <span class="hidden sm:inline">Descargar</span>
                                        </a>
                                    </div>
                                }

                                @if (contenido.Tipo == TipoContenido.Video && !string.IsNullOrEmpty(contenido.UrlVideo))
                                {
                                    string embedUrl = contenido.UrlVideo;
                                    if (embedUrl.Contains("youtube.com/watch?v="))
                                    {
                                        embedUrl = embedUrl.Replace("youtube.com/watch?v=", "youtube.com/embed/").Split('&')[0];
                                    }
                                    else if (embedUrl.Contains("youtu.be/"))
                                    {
                                        embedUrl = embedUrl.Replace("youtu.be/", "youtube.com/embed/").Split('?')[0];
                                    }

                                    <div class="w-full bg-gray-900 rounded-2xl overflow-hidden shadow-inner border border-gray-100">
                                        <iframe src="@embedUrl"
                                                class="w-full aspect-video"
                                                frameborder="0"
                                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                allowfullscreen>
                                        </iframe>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-16 bg-white rounded-3xl border border-gray-100 border-dashed">
                    <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-box-open text-3xl text-gray-300"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Aula Vacía</h3>
                    <p class="text-gray-500 mb-6 max-w-sm mx-auto">Aún no hay anuncios, videos ni documentos para los estudiantes.</p>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Maestro"))
                    {
                        <a asp-action="AgregarContenido" asp-route-cursoId="@Model.Id" class="bg-university-50 text-university-700 px-6 py-2.5 rounded-xl font-bold hover:bg-university-100 transition inline-flex items-center gap-2">
                            <i class="fas fa-plus"></i> Agregar Material
                        </a>
                    }
                </div>
            }
        </div>

        <div class="lg:col-span-1">
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sticky top-24">
                <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-6">Docente Titular</h3>

                <div class="flex flex-col items-center text-center">
                    <div class="w-24 h-24 bg-university-100 text-university-600 rounded-full flex items-center justify-center text-3xl font-bold mb-4 border-4 border-white shadow-md">
                        @(Model.Maestro?.FirstName?.Substring(0, 1) ?? "U")@(Model.Maestro?.LastName?.Substring(0, 1) ?? "")
                    </div>

                    <h4 class="text-xl font-bold text-gray-900 mb-1">@(Model.Maestro?.FirstName ?? "Profesor") @(Model.Maestro?.LastName ?? "No Asignado")</h4>
                    <p class="text-university-600 font-medium text-sm mb-4">@(Model.Maestro?.Email ?? "---")</p>

                    <div class="w-full pt-4 border-t border-gray-100">
                        <div class="flex justify-between text-sm mb-2">
                            <span class="text-gray-500">Clave de Trabajador:</span>
                            <span class="font-mono text-gray-900 font-medium">@(Model.Maestro?.Matricula ?? "N/A")</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">Rol:</span>
                            <span class="bg-blue-50 text-blue-600 px-2 py-0.5 rounded font-bold text-xs">MAESTRO</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-8">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Contenido del Curso por Apartados</h2>
            @if (User.IsInRole("Administrador") || User.IsInRole("Maestro"))
            {
                <a asp-controller="Apartados" asp-action="Index" asp-route-cursoId="@Model.Id"
                   class="bg-university-600 hover:bg-university-700 text-white px-4 py-2 rounded-lg flex items-center gap-2 transition">
                    <i class="fas fa-layer-group"></i>
                    Gestionar Apartados
                </a>
            }
        </div>

        @if (Model.Apartados != null && Model.Apartados.Any())
        {
            <div class="space-y-6">
                @foreach (var apartado in Model.Apartados.OrderBy(a => a.Orden))
                {
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="bg-gradient-to-r from-gray-50 to-white px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-university-100 text-university-700 rounded-xl flex items-center justify-center font-bold text-lg">
                                    @apartado.Orden
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900 text-lg">@apartado.Titulo</h3>
                                    @if (!string.IsNullOrEmpty(apartado.Descripcion))
                                    {
                                        <p class="text-sm text-gray-600">@apartado.Descripcion</p>
                                    }
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-xs font-medium">
                                    @(apartado.Tareas?.Count() ?? 0) tareas
                                </span>
                                @if (User.IsInRole("Administrador") || User.IsInRole("Maestro"))
                                {
                                    <a asp-controller="Apartados" asp-action="Edit" asp-route-id="@apartado.Id"
                                       class="text-amber-600 hover:text-amber-700 p-2 hover:bg-amber-50 rounded-lg transition" title="Editar apartado">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                }
                            </div>
                        </div>

                        @if (apartado.Tareas != null && apartado.Tareas.Any())
                        {
                            <div class="divide-y divide-gray-100">
                                @foreach (var tarea in apartado.Tareas.OrderBy(t => t.FechaLimite))
                                {
                                    // --- LÓGICA DE ESTADO DEL ALUMNO ---
                                    bool entregada = entregas != null && entregas.ContainsKey(tarea.Id);
                                    bool vencida = tarea.FechaLimite < DateTime.Now;
                                    bool calificada = false;
                                    if (entregada) { calificada = entregas[tarea.Id].CalificacionId != null; }

                                    <div class="px-6 py-4 hover:bg-gray-50 transition flex flex-col md:flex-row md:items-center justify-between gap-4">
                                        <div class="flex items-start gap-3">
                                            <div class="mt-1">
                                                @if (calificada)
                                                {
                                                    <i class="fas fa-check-double text-green-500"></i>
                                                }
                                                else if (entregada)
                                                {

                                                    <i class="fas fa-file-upload text-blue-500"></i>
                                                }
                                                else if (vencida)
                                                {

                                                    <i class="fas fa-clock text-red-500"></i>
                                                }
                                                else
                                                {

                                                    <i class="fas fa-clipboard-list text-university-500"></i>
                                                }
                                            </div>
                                            <div>
                                                <div class="flex items-center gap-2">
                                                    <a asp-controller="Tareas" asp-action="Detalle" asp-route-id="@tarea.Id"
                                                       class="font-medium text-gray-900 hover:text-university-600">
                                                        @tarea.Titulo
                                                    </a>
                                                    @if (!string.IsNullOrEmpty(tarea.TipoTarea))
                                                    {
                                                        <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full">@tarea.TipoTarea</span>
                                                    }
                                                </div>
                                                <div class="text-sm text-gray-500 mt-1">
                                                    <i class="far fa-calendar-alt mr-1"></i> Límite: @tarea.FechaLimite.ToString("dd/MM/yyyy HH:mm")
                                                    @if (calificada)
                                                    {
                                                        <span class="ml-2 text-green-600 font-bold">(Calificada)</span>
                                                    }
                                                    else if (entregada)
                                                    {

                                                        <span class="ml-2 text-blue-600 font-bold">(Entregada)</span>
                                                    }
                                                    else if (vencida)
                                                    {

                                                        <span class="ml-2 text-red-500 font-bold">(Vencida)</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-4">
                                            <span class="text-sm font-bold text-university-600">@tarea.PuntosTotales pts</span>

                                            @if (User.IsInRole("Alumno"))
                                            {
                                                <a asp-controller="Tareas" asp-action="Detalle" asp-route-id="@tarea.Id"
                                                   class="px-5 py-2 rounded-xl font-bold text-sm transition-all shadow-sm
                                                                       @(calificada ? "bg-green-600 text-white hover:bg-green-700" :
                                                                                                        (entregada ? "bg-blue-600 text-white hover:bg-blue-700" :
                                                                                                        (vencida ? "bg-gray-100 text-gray-400 cursor-not-allowed" : "bg-university-600 text-white hover:bg-university-700 shadow-university-100"))) ">

                                @if (calificada)
                                                    {
                                                        <i class="fas fa-certificate mr-1"></i>
                                                        <span>Ver Nota</span>
                     }
                                                    else if (entregada)
                                                    {
                                                        <i class="fas fa-check-double mr-1"></i>
                                                        <span>Entregada</span>
                     }
                                                    else if (vencida)
                                                    {
                                                        <i class="fas fa-lock mr-1"></i>
                                                        <span>Cerrada</span>
                     }
                                                    else
                                                    {
                                                        <i class="fas fa-upload mr-1"></i>
                                                        <span>Entregar</span>
                     }
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="px-6 py-8 text-center text-gray-500">
                                <i class="fas fa-tasks text-3xl mb-2 opacity-50"></i>
                                <p class="text-sm">No hay tareas en este apartado</p>
                                @if (User.IsInRole("Administrador") || User.IsInRole("Maestro"))
                                {
                                    <a asp-controller="Apartados" asp-action="CreateTarea" asp-route-apartadoId="@apartado.Id"
                                       class="mt-2 inline-flex items-center gap-1 text-university-600 hover:text-university-700 text-sm">
                                        <i class="fas fa-plus-circle"></i>
                                        Crear tarea
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-gray-50 rounded-2xl p-12 text-center border border-dashed border-gray-300">
                <i class="fas fa-layer-group text-5xl text-gray-300 mb-4"></i>
                <h3 class="text-xl font-bold text-gray-900 mb-2">Este curso no tiene apartados</h3>
                <p class="text-gray-500 mb-6">Organiza tu contenido creando apartados (temas, unidades, módulos...)</p>
                @if (User.IsInRole("Administrador") || User.IsInRole("Maestro"))
                {
                    <a asp-controller="Apartados" asp-action="Create" asp-route-cursoId="@Model.Id"
                       class="bg-university-600 hover:bg-university-700 text-white px-6 py-3 rounded-lg inline-flex items-center gap-2 transition">
                        <i class="fas fa-plus-circle"></i>
                        Crear Primer Apartado
                    </a>
                }
                else
                {
                    <p class="text-gray-400">El profesor aún no ha organizado el contenido del curso.</p>
                }
            </div>
        }
    </div>
</div>