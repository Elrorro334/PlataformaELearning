<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Plataforma e-Learning</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        university: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            300: '#86efac',
                            400: '#4ade80',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 font-sans antialiased text-gray-900 flex flex-col min-h-screen">
    <header>
        <nav class="bg-white border-b border-gray-100 px-6 py-4 flex justify-between items-center shadow-sm sticky top-0 z-50">
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2">
                        <div class="bg-university-600 p-2 rounded-lg shadow-inner">
                            <i class="fas fa-graduation-cap text-white text-xl"></i>
                        </div>
                        <span class="font-extrabold text-xl tracking-tight text-gray-800">Edu<span class="text-university-600">Nix</span></span>
                    </a>
                </div>

                <!-- Menú de Cursos (visible para usuarios autenticados) -->
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="hidden md:flex items-center space-x-4 ml-6">
                        <a asp-controller="Cursos" asp-action="Index"
                           class="text-gray-600 hover:text-university-600 px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cursos" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "bg-university-50 text-university-600" : "")">
                            <i class="fas fa-book-open"></i>
                            Mis Cursos
                        </a>

                        <a asp-controller="Cursos" asp-action="Create"
                           class="text-gray-600 hover:text-university-600 px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cursos" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "bg-university-50 text-university-600" : "")">
                            <i class="fas fa-plus-circle"></i>
                            Nuevo Curso
                        </a>

                        <!-- Dropdown para más opciones de cursos (opcional) -->
                        <div class="relative group">
                            <button class="text-gray-600 hover:text-university-600 px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2">
                                <i class="fas fa-chevron-down"></i>
                                Más
                            </button>
                            <div class="absolute left-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 hidden group-hover:block border border-gray-100 z-50">
                                <a asp-controller="Cursos" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-university-50 hover:text-university-600">
                                    <i class="fas fa-list mr-2"></i>Todos los Cursos
                                </a>
                                <a asp-controller="Cursos" asp-action="Create" class="block px-4 py-2 text-sm text-gray-700 hover:bg-university-50 hover:text-university-600">
                                    <i class="fas fa-plus mr-2"></i>Crear Curso
                                </a>
                                <div class="border-t border-gray-100 my-1"></div>
                                <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-university-50 hover:text-university-600">
                                    <i class="fas fa-chart-line mr-2"></i>Estadísticas
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="flex items-center gap-4">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="hidden md:block text-right mr-2">
                        <p class="text-sm font-bold text-gray-800">@User.Identity.Name</p>
                        <p class="text-xs text-university-600 font-medium">@User.Claims.FirstOrDefault(c => c.Type == "Matricula")?.Value</p>
                    </div>

                    <a asp-controller="Profile" asp-action="Index" class="w-10 h-10 rounded-full bg-university-100 text-university-600 flex items-center justify-center hover:bg-university-200 transition-colors border border-university-200" title="Mi Perfil">
                        <i class="fas fa-user"></i>
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="text-gray-500 hover:text-red-500 transition-colors p-2 rounded-lg hover:bg-red-50" title="Cerrar Sesión">
                            <i class="fas fa-sign-out-alt text-lg"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-gray-600 hover:text-university-600 font-medium transition">Entrar</a>
                    <a asp-controller="Account" asp-action="Register" class="bg-university-600 text-white px-5 py-2 rounded-full font-medium hover:bg-university-700 transition transform hover:scale-105 shadow-lg shadow-university-200/50">Registrarse</a>
                }
            </div>
        </nav>

        <!-- Breadcrumb de navegación para cursos (opcional) -->
        @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Cursos")
        {
            <div class="bg-white border-b border-gray-100 px-6 py-2 text-sm">
                <div class="max-w-7xl mx-auto flex items-center gap-2 text-gray-500">
                    <i class="fas fa-home text-xs"></i>
                    <a asp-controller="Home" asp-action="Index" class="hover:text-university-600">Inicio</a>
                    <i class="fas fa-chevron-right text-xs"></i>
                    <span class="text-university-600 font-medium">Cursos</span>

                    @if (ViewContext.RouteData.Values["action"]?.ToString() == "Details" && ViewBag.CursoNombre != null)
                    {
                        <i class="fas fa-chevron-right text-xs"></i>
                        <span class="text-gray-700">@ViewBag.CursoNombre</span>
                    }
                    else if (ViewContext.RouteData.Values["action"]?.ToString() == "Create")
                    {
                        <i class="fas fa-chevron-right text-xs"></i>
                        <span class="text-gray-700">Crear Nuevo Curso</span>
                    }
                    else if (ViewContext.RouteData.Values["action"]?.ToString() == "Edit")
                    {
                        <i class="fas fa-chevron-right text-xs"></i>
                        <span class="text-gray-700">Editar Curso</span>
                    }
                    else if (ViewContext.RouteData.Values["action"]?.ToString() == "AgregarContenido")
                    {
                        <i class="fas fa-chevron-right text-xs"></i>
                        <span class="text-gray-700">Agregar Contenido</span>
                    }
                </div>
            </div>
        }
    </header>

    <!-- Área para mostrar notificaciones Toastr -->
    <div class="fixed top-20 right-4 z-50" id="toastContainer"></div>

    <main role="main" class="flex-grow">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-gray-100 py-6 text-center text-sm text-gray-400 mt-auto">
        <p>&copy; 2026 - Universidad Tecnológica - EduNix Platform</p>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        // Configuración global de Toastr
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "newestOnTop": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "preventDuplicates": false,
            "onclick": null,
            "showDuration": "300",
            "hideDuration": "1000",
            "timeOut": "5000",
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>